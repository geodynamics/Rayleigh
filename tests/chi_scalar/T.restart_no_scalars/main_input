&problemsize_namelist
 n_r = 48
 n_theta = 64
 nprow = 2
 npcol = 2
 aspect_ratio = 0.35d0
 shell_depth = 1.0d0
/
&numerical_controls_namelist
/
&physical_controls_namelist
 benchmark_mode = 0
 rotation  = .True.
 magnetism = .false.
 viscous_heating = .false.
 ohmic_heating = .false.
 n_active_scalars = 0
 n_passive_scalars = 0
/
&temporal_controls_namelist
 max_time_step = 7.5e-5
 max_iterations = 1
 checkpoint_interval = 10000
 cflmin = 0.4d0
 cflmax = 0.6d0
/
&io_controls_namelist
/
&output_namelist
globalavg_values = 401,501,503,505,507,509,511,513,515,517,519,521,523
globalavg_frequency = 1
globalavg_nrec = 1
/
&Boundary_Conditions_Namelist
no_slip_boundaries = .true.
strict_L_Conservation = .false.
T_Top    = 0.0d0
T_Bottom = 1.0d0
fix_tvar_top = .true.
fix_tvar_bottom = .true.
/
&Initial_Conditions_Namelist
init_type = -1   ! restarts from T's checkpoint (n_active_scalars=2 there);
                  ! T's own last_checkpoint pointer correctly points at 17,
                  ! its only checkpoint, so no explicit restart_iter is
                  ! needed (matches T.check's convention).
/
&Test_Namelist
/
&Reference_Namelist
Ekman_Number = 1.0d-3
Rayleigh_Number = 1.0d5
Prandtl_Number = 1.0d0
Magnetic_Prandtl_Number = 5.0d0
reference_type = 1
heating_type = 0      ! No heating
gravity_power = 1.0d0  ! g ~ radius
/
&Transport_Namelist
/
